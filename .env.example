# Copy to .env and fill in real values.
# NEXT_PUBLIC_* are read by docker-compose as build args (inlined into client
# bundle); the whole file is also loaded at runtime via env_file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=Example Site

# Ghost Content API (server-side, runtime only)
GHOST_API_URL=https://blog.example.com
GHOST_CONTENT_KEY=your-ghost-content-api-key
